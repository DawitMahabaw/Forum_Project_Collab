# ==========================================
# 1. Global / OS / Editor Files
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==========================================
# 2. Dependency Directories (Strict Paths)
# ==========================================
/node_modules/
/backend/node_modules/
/frontend/node_modules/

# ==========================================
# 3. Environment Variables (Security Sensitive)
# ==========================================
.env
.env.local
.env.*.local
/backend/.env
/frontend/.env
*.local

# ==========================================
# 4. Build & Production Outputs
# ==========================================
/frontend/dist/
/frontend/dist-ssr/
/frontend/build/
/frontend/coverage/

# ==========================================
# 5. Project Specific / Media Uploads
# ==========================================
/backend/uploads/*
!/backend/uploads/.gitkeep

# ==========================================
# 6. Runtime Logs
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
