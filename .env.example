# This file documents project-wide environment variables.
# Do not put real secrets in this file.

# Backend
PORT=4000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=418158
DB_NAME=evangadi_forum_collab

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Google Gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional: leave blank unless you have confirmed another current text model.
GEMINI_FALLBACK_MODEL=

# Semantic search
SEMANTIC_SEARCH_DEFAULT_K=10
SEMANTIC_SEARCH_RECOMMEND_THRESHOLD=0.6
SEMANTIC_SEARCH_MAX_K=20
SEMANTIC_SEARCH_BACKFILL_LIMIT=10

